# ThreadPixel Configuration

# Application
APP_NAME=ThreadPixel
APP_ENV=local
APP_URL=http://localhost/threadpixel

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=threadpixel_db
DB_USERNAME=root
DB_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@threadpixel.com
MAIL_FROM_NAME="${APP_NAME}"

# Security
CSRF_TOKEN_SECRET=ChangeThisToARandomString12345!
SESSION_LIFETIME=120
